# Environment Variables — Nayaab Engineering
# Copy this file to .env and fill in your actual values

# Web3Forms (Contact Form)
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Supabase (Database & Auth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_URL=https://your-project.supabase.co

# Admin
VITE_ADMIN_EMAIL=admin@example.com

# Cloudflare R2 (Image Storage)
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_ACCESS_KEY_ID=your_cloudflare_access_key_id
CF_SECRET_ACCESS_KEY=your_cloudflare_secret_access_key
CF_BUCKET_NAME=your_bucket_name
CF_PUBLIC_DOMAIN=https://your-r2-public-domain.r2.dev

# Google Reviews Widget
VITE_FEATURABLE_API_URL=https://featurable.com/api/v2/widgets/your_widget_id
